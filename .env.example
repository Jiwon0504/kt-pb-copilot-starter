# ── 개인별 API 키 ────────────────────────────────────────────
# 배부받은 키를 붙여넣을 것. 이 파일을 .env 로 복사해서 사용함.
ANTHROPIC_API_KEY=여기에_발급받은_키를_입력

# 생성에 사용할 모델
MODEL=claude-sonnet-4-5

# ── 검색 설정 ────────────────────────────────────────────────
# 벡터 백엔드: auto(기본) | st | sklearn | hash
#   auto     : st → sklearn → hash 순서로 자동 선택함
#   sklearn  : 문자 n-gram TF-IDF + LSA. 인터넷 없이 항상 동작함
#   st       : sentence-transformers 로컬 모델 (MODEL_DIR 필요)
EMBEDDING_BACKEND=auto
# MODEL_DIR=./models/embedding

# Hybrid 결합 가중치 (실습 3에서 조정함)
W_BM25=0.5
W_VECTOR=0.5
TOP_K=5
